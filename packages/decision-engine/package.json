{
  "name": "@vera/decision-engine",
  "version": "0.1.0",
  "description": "Turns a decide request + compiled policy set + evidence into a verdict: reason codes, risk score, confidence, review routing with SoD, expiry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vera/canon": "workspace:*",
    "@vera/policy-engine": "workspace:*",
    "@vera/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
