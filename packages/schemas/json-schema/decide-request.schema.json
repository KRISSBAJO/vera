{
  "$id": "https://vera.dev/schemas/decide-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ai_agent",
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runtime": {
          "type": "string",
          "maxLength": 200
        },
        "session_id": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "acting_for": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trust": {
          "type": "string",
          "const": "asserted"
        }
      },
      "required": [
        "type",
        "id",
        "trust"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "class": {
          "type": "string",
          "enum": [
            "file.read",
            "vcs.read",
            "http.read",
            "db.read",
            "search",
            "file.write",
            "shell.exec",
            "vcs.push",
            "vcs.merge",
            "deploy.staging",
            "deploy.production",
            "db.write",
            "db.ddl",
            "secret.read",
            "secret.write",
            "infra.change",
            "http.mutation",
            "message.send",
            "payment.create",
            "unknown.consequential"
          ]
        },
        "arguments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "environment": {
          "type": "string",
          "maxLength": 100
        },
        "hints": {
          "type": "object",
          "properties": {
            "destructive": {
              "type": "boolean"
            },
            "idempotent": {
              "type": "boolean"
            },
            "open_world": {
              "type": "boolean"
            },
            "read_only": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "type",
        "tool",
        "class",
        "arguments"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": {}
    },
    "context": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "maxLength": 300
        },
        "branch": {
          "type": "string",
          "maxLength": 300
        },
        "cwd": {
          "type": "string",
          "maxLength": 1000
        },
        "local_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "additionalProperties": {}
    },
    "evidence": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "trust": {
            "type": "string",
            "const": "asserted"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ttl_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "type",
          "source",
          "trust",
          "observed_at",
          "data"
        ]
      }
    },
    "receiver": {
      "type": "object",
      "properties": {
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "aud"
      ]
    }
  },
  "required": [
    "request_id",
    "idempotency_key",
    "actor",
    "action"
  ]
}
