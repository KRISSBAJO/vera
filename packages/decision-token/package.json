{
  "name": "@vera/decision-token",
  "version": "0.1.0",
  "description": "Issue and verify VERA decision tokens (EdDSA JWS bound to an action hash), tenant JWKS with revocation, single-use registry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vera/schemas": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vera/canon": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
