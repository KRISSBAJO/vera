{
  "$id": "https://vera.dev/schemas/decision-token-claims",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "jti": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "REVIEW"
      ]
    },
    "action_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "acting_for": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approver": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "policy_set_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "single_use": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "iss",
    "sub",
    "jti",
    "aud",
    "tenant",
    "decision",
    "action_hash",
    "actor",
    "policy_set_version",
    "iat",
    "exp",
    "single_use"
  ]
}
