# Local development (infra/docker-compose.yml)
# The app connects as vera_app (NOSUPERUSER, NOBYPASSRLS) so row-level security applies.
DATABASE_URL=postgres://vera_app:vera_app@localhost:55432/vera
# Migrations run as the owning superuser. Never use this URL in the app.
MIGRATION_DATABASE_URL=postgres://vera:vera@localhost:55432/vera
REDIS_URL=redis://localhost:6380
# 32 random bytes, base64. Seals tenant private signing keys at rest in development.
# Production uses a KMS behind the same Signer interface (ADR-0001). Generate: openssl rand -base64 32
VERA_MASTER_KEY=
# Public base URL used as token issuer prefix and in review links
VERA_PUBLIC_URL=http://localhost:4000
PORT=4000
