{
  "name": "@vera/policy-engine",
  "version": "0.1.0",
  "description": "Cedar policy evaluation with VERA's three-outcome mapping (forbid → BLOCK, @vera_effect(\"review\") permit → REVIEW, permit → ALLOW), policy tests, and diagnostics → reason codes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.12.0",
    "@vera/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
