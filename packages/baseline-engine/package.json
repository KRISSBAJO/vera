{
  "name": "@vera/baseline-engine",
  "version": "0.1.0",
  "description": "Deterministic per-organisation behavioural baselines: novelty, time-of-day, magnitude, frequency. Adds severity to a decision, never lowers it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vera/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
