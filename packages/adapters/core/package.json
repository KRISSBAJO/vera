{
  "name": "@vera/adapter-core",
  "version": "0.1.0",
  "description": "Shared adapter runtime: VERA HTTP client, offline token verification, and the REVIEW hold loop. Verifies tokens; never issues them.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vera/canon": "workspace:*",
    "@vera/decision-token": "workspace:*",
    "@vera/schemas": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
