{
  "$id": "https://vera.dev/schemas/tenant-jwks",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1
          },
          "kty": {
            "type": "string",
            "const": "OKP"
          },
          "crv": {
            "type": "string",
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "const": "sig"
          },
          "alg": {
            "type": "string",
            "const": "EdDSA"
          }
        },
        "required": [
          "kid",
          "kty",
          "crv",
          "x"
        ],
        "additionalProperties": {}
      }
    },
    "revoked": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "keys"
  ]
}
