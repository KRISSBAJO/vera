# Local development (infra/docker-compose.yml)
# The app connects as vera_app (NOSUPERUSER, NOBYPASSRLS) so row-level security applies.
DATABASE_URL=postgres://vera_app:vera_app@localhost:55432/vera
# Migrations run as the owning superuser. Never use this URL in the app.
MIGRATION_DATABASE_URL=postgres://vera:vera@localhost:55432/vera
REDIS_URL=redis://localhost:6380

# --- Pilot stack only (infra/docker-compose.pilot.yml) ---
# Postgres is not published to the host there, so these are never typed into a psql prompt; generate
# them and forget them. The app-role password is read the first time the volume is created — changing
# it later needs an ALTER ROLE, not just an edit here.
POSTGRES_PASSWORD=
VERA_APP_PASSWORD=
# Ports on the host, if 4000/4100 are taken.
VERA_API_PORT=4000
VERA_DASHBOARD_PORT=4100
# 32 random bytes, base64. Seals tenant private signing keys at rest in development.
# Production uses KMS behind the same Signer interface (see VERA_KMS_* below). Generate: openssl rand -base64 32
VERA_MASTER_KEY=

# --- Decision signing in KMS (ADR-0005) ---
# Optional. With these set, `vera-api register-kms-key --org-id <id> --arn <arn>` moves a tenant's
# signing to a key whose private half never reaches this process. The key must be ECC_NIST_EDWARDS25519.
VERA_KMS_REGION=
VERA_KMS_KEY_ARN=
# A dedicated IAM identity with kms:Sign, kms:GetPublicKey and kms:DescribeKey on that one key ARN —
# nothing wider. Named VERA_KMS_* rather than AWS_* so it cannot be confused with, or quietly widened
# to, ambient AWS credentials used by other services.
VERA_KMS_ACCESS_KEY_ID=
VERA_KMS_SECRET_ACCESS_KEY=
# On EC2/ECS/EKS, leave the two above empty and set this to use the instance role instead. VERA never
# falls back to ambient AWS credentials on its own: signing identity has to be chosen, not inherited.
VERA_KMS_USE_AMBIENT_CREDENTIALS=
# Public base URL used as token issuer prefix and in review links
VERA_PUBLIC_URL=http://localhost:4000
PORT=4000

# --- Third-party credentials (none are read yet; listed so .env is ready) ---
# GitHub App for the evidence provider (verified PR approval / CI status). Read-only permissions.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
# LLM helpers (natural language → Cedar drafts, reviewer summaries). Never a decision authority (brief §13).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Slack app for review notifications (ADR-0006). Scopes: chat:write, users:read, users:read.email —
# nothing that reads channel history or files. VERA posts and resolves reviewer identity; it does not
# read your conversations.
# Bot token (xoxb-…), from OAuth & Permissions after installing the app to the workspace.
SLACK_BOT_TOKEN=
# Signing secret, from Basic Information. Verifies that a request really came from Slack.
SLACK_SIGNING_SECRET=
# Channel or user id review requests are posted to, e.g. C0123ABCD.
SLACK_REVIEW_CHANNEL=
# App-level token (xapp-…) with connections:write. Only needed once Slack approvals land; Socket Mode
# is already enabled on the app so a pilot behind a firewall needs no public URL.
SLACK_APP_TOKEN=
