{
  "name": "@vera/schemas",
  "version": "0.1.0",
  "description": "Wire schemas for VERA: decide request/response, decision-token claims, reason codes, action classes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export": "tsx scripts/export-json-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
