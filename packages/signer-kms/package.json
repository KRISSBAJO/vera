{
  "name": "@vera/signer-kms",
  "version": "0.1.0",
  "description": "Signer backed by AWS KMS: the private key never leaves the HSM. Depended on only by the API — adapters must never pull in the AWS SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@vera/decision-token": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vera/schemas": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
